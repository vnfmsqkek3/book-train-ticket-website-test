# ─────────────────────────────────────────────
# 환경변수 템플릿 (baseline #5: dev/staging/prod 분리)
# 사용: cp .env.example .env.dev / .env.staging / .env.prod
# ─────────────────────────────────────────────

# 실행 환경
NODE_ENV=development           # development | staging | production
APP_ENV=dev                    # dev | staging | prod

# 백엔드 서버
PORT=4000
WS_PORT=4001

# 인증
JWT_SECRET=change-me-in-real-env
JWT_EXPIRES_IN=1h

# MySQL RDS
DB_HOST=localhost
DB_PORT=3306
DB_USER=ticket
DB_PASSWORD=ticket
DB_NAME=ticket_booking

# Redis / ElastiCache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 동시성 제어 (make.md §2)
CONCURRENT_PROCESSING_LIMIT=500
SEAT_LOCK_TTL_SECONDS=300

# 프론트엔드
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001
